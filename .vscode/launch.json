{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python Debugger: Current File",
            "type": "debugpy",
            "request": "launch",
            "program": "${file}",
            "console": "integratedTerminal",
            "env": {
                "XLA_FLAGS": "--xla_gpu_autotune_level=0"
            },
        },
        {
            "name": "Parse ros2 bags to lerobot format",
            "type": "debugpy",
            "request": "launch",
            "program": "examples/ur5/parse_ur5e_bags_to_lerobot.py",
            "console": "integratedTerminal",
            "args": [
                "csv",
                "--tasks_csv", "/data/20251110_ur5e_2f85_jazzy/bag_index.csv",
                "--bags_dir", "/data/20251110_ur5e_2f85_jazzy/",
                "--time_source", "record",
                "--dataset_name", "ur5e_2f85_marker_in_bowl_100"
            ]
        },
        {
            "name": "Compute normstats from lerobot dataset",
            "type": "debugpy",
            "request": "launch",
            "program": "scripts/compute_norm_stats.py",
            "console": "integratedTerminal",
            "args": [                
                "--config_name", "ur5e_2f85_pi0_fast_lora_finetune_local"
            ]
        }
    ]
}